{
  "cli": {
    "version": ">= 25.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:3000/api/mobile"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://clearsys-git-android-parity-integration-kentbsece-7567.vercel.app/api/mobile",
        "EAS_GRADLE_CACHE": "1",
        "EAS_USE_CACHE": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://clearsys.vercel.app/api/mobile",
        "EXPO_PUBLIC_CLEAR_TENANT_OPERATIONS": "false"
      },
      "android": {
        "image": "latest",
        "buildType": "app-bundle"
      }
    },
    "live-readonly-internal": {
      "distribution": "internal",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://clearsys.vercel.app/api/mobile",
        "EXPO_PUBLIC_CLEAR_RELEASE_KIND": "live-readonly-internal"
      },
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
