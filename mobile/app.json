{
  "expo": {
    "name": "CLEAR",
    "slug": "clear-mobile",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/clear-icon.png",
    "scheme": "clearsys",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rupertbulquerin.clear",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rupertbulquerin.clear",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0b1329",
        "foregroundImage": "./assets/images/clear-adaptive-foreground.png",
        "monochromeImage": "./assets/images/clear-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1329",
          "image": "./assets/images/clear-splash.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CLEAR uses your photos to attach GCash or Maya receipt screenshots.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
