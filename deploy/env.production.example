# ~/clear-sys/.env.production on the VPS (chmod 600). deploy/push-env.ps1 writes it
# from your local .env.production.backup, so normally you don't edit this by hand.
# Next.js reads it at build time and at runtime.

# Neon (same database as before). The pooled URL works for the app; run
# migrations from your PC (see deploy/README.md), not on the VPS.
DATABASE_URL=
DIRECT_URL=

# Auth.js. Behind Apache it must be told the public URL / to trust the proxy;
# on Vercel this was automatic.
AUTH_SECRET=
AUTH_URL=https://__DOMAIN__
AUTH_TRUST_HOST=true

# Super Admin (no fallback: unset means nobody is Super Admin)
SUPER_ADMIN_EMAIL=

# Mail (Gmail SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Vercel Blob (logos); works outside Vercel with the token
BLOB_READ_WRITE_TOKEN=

# Optional: dedicated secret for clearance QR signatures (defaults to AUTH_SECRET)
# CLEARANCE_SALT=

# Optional, off by default: Google Play reviewer sign-in. When both are set, this
# one email in the `demo` org (prisma/seed-demo.js) gets this fixed six-digit code
# instead of an emailed one; no other email or organization is affected.
# See "Play review demo sign-in" in deploy/README.md.
# DEMO_REVIEWER_EMAIL=reviewer@demo.clear.invalid
# DEMO_REVIEWER_CODE=
