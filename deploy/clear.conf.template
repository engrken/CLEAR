# Apache vhost for CLEAR. deploy/README.md: replace __DOMAIN__, install as
# /etc/apache2/sites-available/__DOMAIN__.conf, then run certbot --apache, which
# adds the HTTPS vhost and the HTTP -> HTTPS redirect.
<VirtualHost *:80>
    ServerName __DOMAIN__

    # Only serves the ACME challenge; everything else is proxied to CLEAR (PM2 "clear-sys").
    DocumentRoot /var/www/clear-root

    ProxyPreserveHost On
    ProxyPass /.well-known/acme-challenge/ !
    ProxyPass / http://127.0.0.1:3040/
    ProxyPassReverse / http://127.0.0.1:3040/

    RequestHeader set X-Forwarded-Proto "https"

    ErrorLog ${APACHE_LOG_DIR}/__DOMAIN__-error.log
    CustomLog ${APACHE_LOG_DIR}/__DOMAIN__-access.log combined
</VirtualHost>
