generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  penaltySettlementEvents     PenaltySettlementEvent[]
  id                          String                       @id @default(uuid())
  subdomain                   String                       @unique
  name                        String
  schoolGroup                 String                       @default("default-school")
  tier                        String                       @default("Freemium")
  status                      String                       @default("Active")
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @default(now()) @updatedAt @db.Timestamptz(3)
  activeAy                    String                       @default("A.Y. 2026 - 2027")
  activeTerm                  String                       @default("1st Sem")
  type                        String                       @default("Department")
  logo                        String?
  reportSchoolName            String?                      @db.VarChar(255)
  reportSchoolAddress         String?
  reportHeaderLeftLogo        String?                      @db.VarChar(255)
  reportHeaderRightLogo       String?                      @db.VarChar(255)
  audits                      Audit[]
  cashAdvances                CashAdvance[]
  cashierRemittances          CashierRemittance[]
  collectibles                Collectible[]
  collections                 Collection[]
  collectionSetups            CollectionSetup[]
  enrollments                 Enrollment[]
  expenseItems                ExpenseItem[]
  funds                       Fund[]
  realignments                FundRealignment[]
  fundTransfers               FundTransfer[]
  MobileSession               MobileSession[]
  onlineRemittances           OnlineRemittance[]
  penalties                   Penalty[]
  signatories                 Signatory[]
  students                    Student[]
  systemLogs                  SystemLog[]
  tenantUsers                 TenantUser[]
  voidTransactions            VoidTransaction[]
  academicPeriodConfigs       AcademicPeriodConfig[]
  academicPeriodTransitions   AcademicPeriodTransition[]
  arrearPaymentLinks          ArrearPaymentLink[]
  digitalReceiptDeliveries    DigitalReceiptDelivery[]
  transactionEmailPreferences TransactionEmailPreference[]
}

model Signatory {
  id             String       @id @default(cuid())
  organizationId String
  label          String
  name           String
  position       String
  order          Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Student {
  id             String       @id @default(uuid())
  organizationId String
  studentId      String
  fullName       String
  yearLevel      String
  email          String?
  collections    Collection[]
  enrollments    Enrollment[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, studentId])
}

model Enrollment {
  id               String       @id @default(uuid())
  organizationId   String
  studentId        String
  academicYear     String       @default("A.Y. 2026 - 2027")
  term             String       @default("1st Sem")
  enrollmentStatus String       @default("Enrolled")
  lastUpdated      DateTime     @default(now()) @db.Timestamptz(3)
  updatedBy        String?
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student          Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, academicYear, term, studentId])
}

model Fund {
  id                String       @id @default(uuid())
  organizationId    String
  academicYear      String       @default("A.Y. 2026 - 2027")
  term              String       @default("1st Sem")
  fundName          String
  initialAllocation Decimal        @default(0) @db.Decimal(18, 2)
  currentBalance    Decimal        @default(0) @db.Decimal(18, 2)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, academicYear, term, fundName])
}

model PaymentRequest {
  id             String   @id @default(cuid())
  organizationId String
  requestId      String
  payloadHash    String
  orNumber       String
  outcomeJson    String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  @@unique([organizationId, requestId])
  @@index([organizationId, orNumber])
}

model Collection {
  penaltySettlementEvents PenaltySettlementEvent[]
  id                      String                   @id @default(uuid())
  organizationId          String
  timestamp               DateTime                 @default(now()) @db.Timestamptz(3)
  academicYear            String                   @default("A.Y. 2026 - 2027")
  term                    String                   @default("1st Sem")
  date                    DateTime                 @default(now())
  studentId               String?
  studentName             String
  orNumber                String
  category                String
  itemDescription         String
  paymentType             String
  standardRate            Decimal                    @default(0) @db.Decimal(18, 2)
  amountPaid              Decimal                    @default(0) @db.Decimal(18, 2)
  balanceDue              Decimal                    @default(0) @db.Decimal(18, 2)
  fundAllocation          String
  status                  String                   @default("Valid")
  encodedBy               String?
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student                 Student?                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  arrearPaymentLinks      ArrearPaymentLink[]

  @@unique([organizationId, orNumber, itemDescription])
  @@index([organizationId, academicYear, term])
}

model CollectionSetup {
  id             String       @id @default(cuid())
  organizationId String
  category       String
  name           String
  amount         Decimal @db.Decimal(18, 2)
  targetFund     String
  academicYear   String
  term           String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  isPackage      Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, academicYear, term])
}

model Penalty {
  settlementEvents PenaltySettlementEvent[]
  assessedAmount   Decimal? @db.Decimal(18, 2)
  penaltyType      String                   @default("SERVICE_ELIGIBLE")
  id               String                   @id @default(uuid())
  organizationId   String
  penaltyId        String                   @unique
  academicYear     String                   @default("A.Y. 2026 - 2027")
  term             String                   @default("1st Sem")
  date             DateTime                 @default(now())
  studentId        String?
  studentName      String
  activity         String
  hoursLate        Float                    @default(0)
  ratePerHour      Decimal                    @default(50) @db.Decimal(18, 2)
  fineAmount       Decimal                    @default(0) @db.Decimal(18, 2)
  status           String                   @default("Unsettled")
  encodedBy        String?
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, studentId, academicYear, term], map: "Penalty_org_student_history_idx")
}

model CashAdvance {
  id                 String       @id @default(uuid())
  organizationId     String
  advanceId          String       @unique
  academicYear       String       @default("A.Y. 2026 - 2027")
  term               String       @default("1st Sem")
  dateIssued         DateTime     @default(now())
  requestor          String
  fundSource         String
  amountApproved     Decimal        @default(0) @db.Decimal(18, 2)
  expectedReturnDate DateTime?
  purpose            String?
  status             String       @default("Active (Unliquidated)")
  encodedBy          String?
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Audit {
  id               String        @id @default(uuid())
  organizationId   String
  auditId          String        @unique
  academicYear     String        @default("A.Y. 2026 - 2027")
  term             String        @default("1st Sem")
  date             DateTime      @default(now())
  referenceCaId    String
  requestor        String
  fundSource       String
  budgetRequested  Decimal         @default(0) @db.Decimal(18, 2)
  totalExpense     Decimal         @default(0) @db.Decimal(18, 2)
  varianceReturn   Decimal         @default(0) @db.Decimal(18, 2)
  reimbursementDue Decimal         @default(0) @db.Decimal(18, 2)
  status           String        @default("Audited & Verified")
  encodedBy        String?
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenseItems     ExpenseItem[]
}

model ExpenseItem {
  id              String       @id @default(uuid())
  organizationId  String
  auditId         String
  orSiNumber      String?
  qty             Int          @default(1)
  description     String
  subTotal        Decimal        @default(0) @db.Decimal(18, 2)
  receiptProofUrl String?
  audit           Audit        @relation(fields: [auditId], references: [auditId], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Collectible {
  id             String       @id @default(uuid())
  organizationId String
  category       String
  academicYear   String       @default("A.Y. 2026 - 2027")
  term           String       @default("1st Sem")
  headcount      Int          @default(1)
  balanceDue     Decimal        @default(0) @db.Decimal(18, 2)
  status         String       @default("Outstanding")
  encodedBy      String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OnlineRemittance {
  id              String       @id @default(uuid())
  organizationId  String
  submissionId    String       @unique
  timestamp       DateTime     @default(now()) @db.Timestamptz(3)
  academicYear    String       @default("A.Y. 2026 - 2027")
  term            String       @default("1st Sem")
  studentId       String?
  studentName     String
  studentEmail    String?
  paymentChannel  String
  referenceNumber String
  category        String
  itemDescription String
  paymentMode     String
  amountPaid      Decimal        @default(0) @db.Decimal(18, 2)
  proofUrl        String?
  status          String       @default("Pending Verification")
  reviewNotes     String?
  reviewedBy      String?
  orNumber        String?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model FundTransfer {
  id              String       @id @default(uuid())
  organizationId  String
  timestamp       DateTime     @default(now()) @db.Timestamptz(3)
  academicYear    String       @default("A.Y. 2026 - 2027")
  term            String       @default("1st Sem")
  sourceFund      String
  destinationFund String
  amount          Decimal        @default(0) @db.Decimal(18, 2)
  reason          String
  encodedBy       String?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SystemLog {
  id             String       @id @default(cuid())
  organizationId String
  timestamp      DateTime     @default(now()) @db.Timestamptz(3)
  user           String
  action         String
  details        String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, timestamp])
}

model TenantUser {
  id                 String          @id @default(cuid())
  organizationId     String
  userId             String
  fullName           String
  username           String
  email              String
  role               String
  allowedTabs        String
  status             String
  otpCode            String?
  otpExpires         DateTime? @db.Timestamptz(3)
  otpAttempts        Int             @default(0)
  otpRequestCount    Int             @default(0)
  otpLastRequestedAt DateTime? @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  onboardingSignature String?
  OfficerPagePresence OfficerPagePresence[]
  MobileSession      MobileSession[]
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([organizationId, username])
  @@unique([organizationId, email])
}

model VerificationToken {
  identifier String   @id
  token      String
  expires    DateTime @db.Timestamptz(3)
}

model VoidTransaction {
  id              String       @id @default(uuid())
  organizationId  String
  transactionType String
  referenceId     String
  amount          Decimal @db.Decimal(18, 2)
  reason          String
  voidedBy        String
  date            DateTime     @default(now()) @db.Timestamptz(3)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model FundRealignment {
  id             String       @id @default(uuid())
  organizationId String
  date           DateTime     @default(now())
  sourceFund     String
  targetFund     String
  amount         Decimal @db.Decimal(18, 2)
  reason         String
  authorizedBy   String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CashierRemittance {
  id               String       @id @default(uuid())
  organizationId   String
  remittanceId     String       @unique
  academicYear     String
  term             String
  date             DateTime     @default(now())
  remittedBy       String
  fundSource       String
  amount           Decimal        @default(0) @db.Decimal(18, 2)
  cashierReceiptNo String?
  remarks          String?
  status           String       @default("Remitted")
  encodedBy        String
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  type             String       @default("Deposit")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuthThrottle {
  key         String    @id
  failedCount Int       @default(0)
  lockedUntil DateTime? @db.Timestamptz(3)
  lastSentAt  DateTime? @db.Timestamptz(3)
  updatedAt   DateTime @db.Timestamptz(3)
}

// Ephemeral, per-page active officer presence, never an editing lock.
// Untrusted client page/tenant claims are validated before writes.
model OfficerPagePresence {
  id             String   @id
  organizationId String
  tenantUserId   String
  pageKey        String
  lastSeen       DateTime @default(now()) @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  officer        TenantUser @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, pageKey, lastSeen])
  @@index([tenantUserId, lastSeen])
}

model MobileSession {
  id             String       @id
  tokenHash      String       @unique
  tenantUserId   String
  organizationId String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)
  lastUsedAt     DateTime     @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  userAgent      String?
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  TenantUser     TenantUser   @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tenantUserId])
}

// Tenant-specific accounting calendar per academic year.
model AcademicPeriodConfig {
  id             String       @id @default(cuid())
  organizationId String
  academicYear   String
  mode           String       @default("Semester")
  includeSummer  Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, academicYear])
  @@index([organizationId])
}

model AcademicPeriodTransition {
  id              String       @id @default(uuid())
  organizationId  String
  sourceAY        String
  sourceTerm      String
  destinationAY   String
  destinationTerm String
  amount          Decimal        @default(0) @db.Decimal(18, 2)
  transferId      String?
  feePolicy       String       @default("manual")
  copiedFeesJson  String       @default("[]")
  reason          String
  closedBy        String
  closedAt        DateTime     @default(now()) @db.Timestamptz(3)
  status          String       @default("Closed")
  reopenedAt      DateTime? @db.Timestamptz(3)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceAY, sourceTerm])
  @@index([organizationId, destinationAY, destinationTerm], map: "APT_org_destination_period_idx")
}

// Explicit link from a current-period receipt to an older obligation.
// Never infer historical linkage from free-text descriptions.
model ArrearPaymentLink {
  id             String       @id @default(uuid())
  organizationId String
  receiptId      String       @unique
  obligationType String
  obligationId   String
  originAY       String
  originTerm     String
  amount         Decimal @db.Decimal(18, 2)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receipt        Collection   @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@index([organizationId, obligationType, obligationId], map: "APL_org_obligation_idx")
}

model PenaltySettlementEvent {
  id              String       @id @default(uuid())
  organizationId  String
  penaltyRecordId String
  receiptId       String?
  method          String
  amount          Decimal @db.Decimal(18, 2)
  minutesRendered Int          @default(0)
  accountingAY    String
  accountingTerm  String
  balanceBefore   Decimal @db.Decimal(18, 2)
  balanceAfter    Decimal @db.Decimal(18, 2)
  recordedBy      String
  note            String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  penalty         Penalty      @relation(fields: [penaltyRecordId], references: [id], onDelete: Restrict)
  receipt         Collection?  @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@index([organizationId, penaltyRecordId, createdAt], map: "PSE_org_penalty_date_idx")
  @@index([organizationId, receiptId], map: "PSE_org_receipt_idx")
}

model DigitalReceiptDelivery {
  id             String       @id @default(cuid())
  organizationId String
  eventKey       String
  documentType   String
  referenceNo    String
  recipientEmail String
  recipientRole  String
  subject        String
  html           String       @db.Text
  status         String       @default("Pending")
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @db.Timestamptz(3)
  lastError      String?
  sentAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "DRD_organization_fk")

  @@unique([organizationId, eventKey, recipientEmail], map: "DRD_unique_delivery")
  @@index([status, nextAttemptAt], map: "DRD_retry_queue_idx")
  @@index([organizationId, createdAt], map: "DRD_org_created_idx")
}

model TransactionEmailPreference {
  id                       String       @id @default(cuid())
  organizationId           String
  email                    String
  receiveParticipantEmails Boolean      @default(true)
  receiveOfficerCopies     Boolean      @default(true)
  createdAt                DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "TEP_org_fk")

  @@unique([organizationId, email], map: "TEP_org_email_unique")
  @@index([organizationId], map: "TEP_org_idx")
}

 
// Global platform operators live outside tenant-specific TenantUser records.
// The original SUPER_ADMIN_EMAIL remains the break-glass/bootstrap operator.
model GlobalSuperAdmin {
  id                  String    @id @default(cuid())
  email               String    @unique
  fullName            String
  status              String    @default("Pending")
  invitedBy           String
  invitationExpiresAt DateTime  @db.Timestamptz(3)
  activatedAt         DateTime? @db.Timestamptz(3)
  disabledAt          DateTime? @db.Timestamptz(3)
  revokedAt           DateTime? @db.Timestamptz(3)
  sessionVersion      Int       @default(1)
  lastLoginAt         DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  @@index([status])
}

model GlobalAdminAudit {
  id          String   @id @default(cuid())
  actorEmail  String
  targetEmail String
  action      String
  details     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  @@index([createdAt])
  @@index([targetEmail, createdAt])
}

/// Revocable global-superadmin bearer sessions. They are deliberately separate
/// from department MobileSession records and never grant tenant permissions.
model GlobalMobileSession {
  id                   String    @id @default(uuid())
  tokenHash            String    @unique
  adminEmail           String
  globalAdminId        String
  globalAdminVersion   Int
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt            DateTime  @db.Timestamptz(3)
  lastUsedAt           DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt            DateTime? @db.Timestamptz(3)
  userAgent            String?

  @@index([adminEmail])
  @@index([expiresAt])
}

  
// A missing row means NORMAL. The singleton GLOBAL row takes precedence over
// any tenant policy; expired policies evaluate as NORMAL without writes.
model MaintenancePolicy {
  scopeKey  String   @id
  mode      String   @default("NORMAL")
  reason    String   @default("")
  expiresAt DateTime? @db.Timestamptz(3)
  updatedBy String
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// Notices are announcements, NOT a way to activate enforcement.
model MaintenanceNotice {
  id        String   @id @default(cuid())
  scopeKey  String
  title     String   @db.VarChar(140)
  message   String   @db.VarChar(800)
  startsAt  DateTime @db.Timestamptz(3)
  endsAt    DateTime @db.Timestamptz(3)
  state     String   @default("DRAFT")
  version   Int      @default(1)
  createdBy String
  updatedBy String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([scopeKey, state, startsAt, endsAt])
}

// Append-only record of changes. No app delete/update functions.
model MaintenanceAudit {
  id        String   @id @default(cuid())
  scopeKey  String
  action    String
  actor     String
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  
  @@index([scopeKey, createdAt])
}
