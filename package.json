  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:seed:dev": "node --env-file=.env prisma/seed-dev.js",
    "db:seed:demo": "node --env-file=.env prisma/seed-demo.js",
